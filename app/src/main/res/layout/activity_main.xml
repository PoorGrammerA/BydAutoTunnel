<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121316">

    <!-- Top Status Banner -->
    <LinearLayout
        android:id="@+id/layout_status_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#263238"
        android:paddingHorizontal="12dp"
        android:paddingVertical="7dp">

        <TextView
            android:id="@+id/tv_tunnel_event_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="GPS 신호 수신 대기 중"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_tunnel_detail_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="2dp"
            android:visibility="gone"
            android:text=""
            android:textColor="#ECEFF1"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Compact Control Bar (Horizontal scroll to support any screen width/orientation) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1E2024"
        android:scrollbars="none"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:gravity="center_vertical">

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_service_enable"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="전원"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginEnd="10dp" />

            <View
                android:layout_width="1dp"
                android:layout_height="18dp"
                android:background="#37474F"
                android:layout_marginEnd="10dp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_auto_close_windows"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="창문 연동"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:layout_marginEnd="10dp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_safe_window_close"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="안전 닫기"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:layout_marginEnd="10dp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_alert_sound"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="알림음"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Map View -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <org.osmdroid.views.MapView
            android:id="@+id/map_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Floating Quick Action Buttons on Map -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:orientation="vertical"
            android:layout_margin="12dp">

            <Button
                android:id="@+id/btn_follow_vehicle"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:backgroundTint="#0288D1"
                android:text="📍 내 위치"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:paddingHorizontal="10dp"
                android:layout_marginBottom="6dp" />

            <Button
                android:id="@+id/btn_open_tunnel_editor"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:backgroundTint="#00838F"
                android:text="터널 DB 편집기"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:paddingHorizontal="10dp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Bottom Telemetry Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#181A1E"
        android:padding="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_telemetry_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="속도: - km/h | 후보 터널: 0개 | GPS 정확도: -"
            android:textColor="#B0BEC5"
            android:textSize="11sp" />
    </LinearLayout>

</LinearLayout>
